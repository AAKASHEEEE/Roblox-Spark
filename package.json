{
  "name": "rblx-spark-video-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Automated, deterministic, original blocky-style vertical comedy video production (validation PoC).",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "setup": "node scripts/doctor.ts",
    "build": "tsc -p tsconfig.web.json",
    "typecheck": "tsc -p tsconfig.web.json --noEmit",
    "start": "node apps/studio/server.ts",
    "render:poc": "node apps/render-worker/render.ts --episode episodes/free-coins-loop-001.json --duration-target 14-18",
    "render:preview": "node apps/render-worker/render.ts --episode episodes/free-coins-loop-001.json --scale 0.5 --out out/preview",
    "render:determinism": "node scripts/determinism.ts",
    "spike": "node scripts/spike-render.ts",
    "stills": "node scripts/stills.ts",
    "assets:lock": "node scripts/assets-lock.ts",
    "test": "node --test tests/*.test.ts",
    "golden:check": "node scripts/golden.ts check",
    "episode:upgrade": "node scripts/episode-version.ts upgrade",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.e2e.test.ts",
    "test:all": "node --test tests/*.test.ts && node --test --test-concurrency=1 tests/e2e/*.e2e.test.ts",
    "bench": "node scripts/bench-generate.ts --set bench/ideas.json --provider rules --out out/bench/rules",
    "bench:holdout": "node scripts/bench-generate.ts --set bench/holdout-ideas.json --provider rules --out out/bench/holdout",
    "bench:render": "node scripts/bench-render.ts",
    "action-reel": "node scripts/action-reel.ts --scale 0.5"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "playwright-core": "1.62.0-alpha-1783623505000"
  }
}
