  "captions": [
    {
      "chunkId": "p01-c01",
      "phraseId": "p01",
      "start": 0.06,
      "end": 3.391,
      "lines": [
        "This is the difference between",
        "Zapp and Kira when the teacher"
      ],
      "emphasisWords": [
        "difference"
      ]
    },
    {
      "chunkId": "p01-c02",
      "phraseId": "p01",
      "start": 3.391,
      "end": 4.3,
      "lines": [
        "leaves the classroom."
      ],
      "emphasisWords": [
        "classroom"
      ]
    },
    {
      "chunkId": "p02-c01",
      "phraseId": "p02",
      "start": 4.6,
      "end": 6.415,
      "lines": [
        "The second the door closes,"
      ],
      "emphasisWords": [
        "closes"
      ]
    },
    {
      "chunkId": "p02-c02",
      "phraseId": "p02",
      "start": 6.415,
      "end": 9.32,
      "lines": [
        "Zapp thinks the entire",
        "classroom belongs to him."
      ],
      "emphasisWords": [
        "classroom"
      ]
    },
    {
      "chunkId": "p03-c01",
      "phraseId": "p03",
      "start": 9.58,
      "end": 13.637,
      "lines": [
        "He jumps up, celebrates,",
        "and starts acting like he"
      ],
      "emphasisWords": [
        "celebrates"
      ]
    },
    {
      "chunkId": "p03-c02",
      "phraseId": "p03",
      "start": 13.637,
      "end": 15.44,
      "lines": [
        "just escaped school forever."
      ],
      "emphasisWords": [
        "forever"
      ]
    },
    {
      "chunkId": "p04-c01",
      "phraseId": "p04",
      "start": 15.68,
      "end": 17.207,
      "lines": [
        "Kira stays at her desk"
      ],
      "emphasisWords": []
    },
    {
      "chunkId": "p04-c02",
      "phraseId": "p04",
      "start": 17.207,
      "end": 20.26,
      "lines": [
        "because she knows the teacher",
        "could return at any moment."
      ],
      "emphasisWords": [
        "because"
      ]
    },
    {
      "chunkId": "p05-c01",
      "phraseId": "p05",
      "start": 20.96,
      "end": 24.067,
      "lines": [
        "Then Zapp notices a suspicious",
        "free-coins button sitting"
      ],
      "emphasisWords": [
        "free-coins"
      ]
    },
    {
      "chunkId": "p05-c02",
      "phraseId": "p05",
      "start": 24.067,
      "end": 25.62,
      "lines": [
        "on the front desk."
      ],
      "emphasisWords": []
    },
    {
      "chunkId": "p06-c01",
      "phraseId": "p06",
      "start": 25.94,
      "end": 29.724,
      "lines": [
        "Kira tells him not to touch it,",
        "which obviously makes him want"
      ],
      "emphasisWords": [
        "obviously"
      ]
    },
    {
      "chunkId": "p06-c02",
      "phraseId": "p06",
      "start": 29.724,
      "end": 31.3,
      "lines": [
        "to press it even more."
      ],
      "emphasisWords": []
    },
    {
      "chunkId": "p07-c01",
      "phraseId": "p07",
      "start": 31.52,
      "end": 34.9,
      "lines": [
        "He slams the button,",
        "and one shiny coin appears."
      ],
      "emphasisWords": [
        "appears"
      ]
    },
    {
      "chunkId": "p08-c01",
      "phraseId": "p08",
      "start": 35.2,
      "end": 38.068,
      "lines": [
        "Zapp celebrates so loudly",
        "that he completely forgets"
      ],
      "emphasisWords": [
        "celebrates"
      ]
    },
    {
      "chunkId": "p08-c02",
      "phraseId": "p08",
      "start": 38.068,
      "end": 39.86,
      "lines": [
        "why the classroom is empty."
      ],
      "emphasisWords": [
        "classroom"
      ]
    },
    {
      "chunkId": "p09-c01",
      "phraseId": "p09",
      "start": 40.24,
      "end": 43.96,
      "lines": [
        "Then the button flashes again,",
        "and the coin begins growing."
      ],
      "emphasisWords": [
        "flashes"
      ]
    },
    {
      "chunkId": "p10-c01",
      "phraseId": "p10",
      "start": 44.22,
      "end": 47.388,
      "lines": [
        "It gets taller than the desk,",
        "wider than Zapp,"
      ],
      "emphasisWords": [
        "taller"
      ]
    },
    {
      "chunkId": "p10-c02",
      "phraseId": "p10",
      "start": 47.388,
      "end": 49.5,
      "lines": [
        "and almost fills",
        "the entire room."
      ],
      "emphasisWords": [
        "almost"
      ]
    },
    {
      "chunkId": "p11-c01",
      "phraseId": "p11",
      "start": 49.86,
      "end": 51.473,
      "lines": [
        "Zapp tries to look confident,"
      ],
      "emphasisWords": [
        "confident"
      ]
    },
    {
      "chunkId": "p11-c02",
      "phraseId": "p11",
      "start": 51.473,
      "end": 54.7,
      "lines": [
        "but Kira has already moved",
        "safely out of the way."
      ],
      "emphasisWords": [
        "already"
      ]
    },
    {
      "chunkId": "p12-c01",
      "phraseId": "p12",
      "start": 55.06,
      "end": 58.375,
      "lines": [
        "The giant coin tips forward",
        "and flattens Zapp against"
      ],
      "emphasisWords": [
        "giant"
      ]
    },
    {
      "chunkId": "p12-c02",
      "phraseId": "p12",
      "start": 58.375,
      "end": 59.48,
      "lines": [
        "the classroom floor."
      ],
      "emphasisWords": [
        "classroom"
      ]
    },
    {
      "chunkId": "p13-c01",
      "phraseId": "p13",
      "start": 59.86,
      "end": 61.423,
      "lines": [
        "At that exact moment,"
      ],
      "emphasisWords": [
        "moment"
      ]
    },
    {
      "chunkId": "p13-c02",
      "phraseId": "p13",
      "start": 61.423,
      "end": 64.94,
      "lines": [
        "the teacher returns and sees",
        "Kira sitting perfectly still."
      ],
      "emphasisWords": [
        "perfectly"
      ]
    },
    {
      "chunkId": "p14-c01",
      "phraseId": "p14",
      "start": 65.3,
      "end": 67.568,
      "lines": [
        "And the free-coins",
        "button quietly resets"
      ],
      "emphasisWords": [
        "free-coins"
      ]
    },
    {
      "chunkId": "p14-c02",
      "phraseId": "p14",
      "start": 67.568,
      "end": 69.08,
      "lines": [
        "for its next victim."
      ],
      "emphasisWords": [
        "victim"
      ]
    }
  ],
